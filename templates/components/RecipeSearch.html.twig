<div>
    <input
        type="search"
        data-model="query"
        class="form-control"
        placeholder="Rechercher une recette..."
    >

    {% if this.recipes is not empty %}
        <ul class="list-group mt-2">
            {% for recipe in this.recipes %}
                <li class="list-group-item">
                    <a href="{{ path('admin.recipe.edit', {id: recipe.id}) }}">
                        {{ recipe.title }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>