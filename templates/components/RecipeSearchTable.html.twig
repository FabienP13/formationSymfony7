<div {{ attributes }}
     data-search-state="{{ this.isSearching ? 'active' : 'inactive' }}">

    <input
        data-model="query"
        class="form-control my-3"
        type="search"
        placeholder="Filtrer les recettes..."
        autocomplete="off"
    />

    {% if this.isSearching %}
        {% if this.recipes|length == 0 %}
            <p class="text-muted">Aucune recette ne correspond à "{{ query }}"</p>
        {% else %}
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Titre</th>
                        <th>Catégorie</th>
                        <th style="width:200px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for recipe in this.recipes %}
                        <tr>
                            <td>{{ recipe.id }}</td>
                            <td>
                                <a href="{{ path('admin.recipe.edit', {id: recipe.id}) }}">
                                    {{ recipe.title }}
                                </a>
                            </td>
                            <td>{{ recipe.category.name | default('') }}</td>
                            <td class='d-flex gap-2'>
                                <a href="{{ path('admin.recipe.edit', {id: recipe.id}) }}" class="btn btn-sm btn-primary">
                                    {{ ux_icon('ph:note-pencil-light', {style: 'font-size:20px'}) }}
                                </a>
                                <form action="{{ path('admin.recipe.delete', {id: recipe.id}) }}" method='post'>
                                    <input type="hidden" name="_method" value='DELETE'>
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        {{ ux_icon('ph:trash', {style: 'font-size:20px'}) }}
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    {% endif %}

</div>